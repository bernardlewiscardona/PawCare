# API environment. Copy to apps/api/.env and adjust. Owner: backend team.
# All variables are validated at startup (src/config/env.validation.ts); the API refuses to start if one is invalid.

# development | test | production
NODE_ENV=development
# Port the API listens on. Change if 3000 is taken.
PORT=3000
# Interface to bind. 0.0.0.0 lets emulators and phones on your LAN reach the API.
HOST=0.0.0.0
# PostgreSQL connection string. Matches compose.yaml defaults. SECRET outside local dev.
DATABASE_URL=postgresql://pawcare:pawcare_local@localhost:5432/pawcare?schema=public
